        "shares_status_check": {
          "name": "shares_status_check",
          "value": "\"shares\".\"status\" IN ('pending', 'active', 'expired', 'revoked')"
        },
        "shares_permissions_check": {
          "name": "shares_permissions_check",
          "value": "cardinality(\"shares\".\"permissions\") > 0\n                AND \"shares\".\"permissions\" <@ ARRAY['READ', 'WRITE']::varchar[]"
        },
        "shares_max_access_count_check": {
          "name": "shares_max_access_count_check",
          "value": "\"shares\".\"max_access_count\" > 0"
        },
        "shares_successful_open_count_check": {
          "name": "shares_successful_open_count_check",
          "value": "\"shares\".\"successful_open_count\" >= 0\n                AND \"shares\".\"successful_open_count\" <= \"shares\".\"max_access_count\""
        },
        "shares_post_open_ttl_check": {
          "name": "shares_post_open_ttl_check",
          "value": "\"shares\".\"post_open_ttl_seconds\" IS NULL\n                OR \"shares\".\"post_open_ttl_seconds\" > 0"
        },
        "shares_post_open_expiry_check": {
          "name": "shares_post_open_expiry_check",
          "value": "(\n                (\"shares\".\"first_opened_at\" IS NULL AND \"shares\".\"post_open_expires_at\" IS NULL)\n                OR\n                (\"shares\".\"first_opened_at\" IS NOT NULL AND \"shares\".\"post_open_expires_at\" IS NOT NULL)\n            )"
        }
