          "name": "vaults_expiry_timestamp_check",
          "value": "\n        (\n            first_shared_at IS NULL\n            AND expires_at IS NULL\n        )\n        OR\n        (\n            first_shared_at IS NOT NULL\n            AND expires_at IS NOT NULL\n            AND expires_at = first_shared_at\n                + overall_ttl_seconds * INTERVAL '1 second'\n        )\n    "
