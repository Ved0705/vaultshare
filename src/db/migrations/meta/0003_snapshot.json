      "checkConstraints": {
        "vaults_status_check": {
          "name": "vaults_status_check",
          "value": "\"vaults\".\"status\" IN ('ACTIVE', 'EXPIRED', 'REVOKED', 'DESTROYED')"
        },
        "vaults_expiry_timestamp_check": {
          "name": "vaults_expiry_timestamp_check",
          "value": "\n        (\n            first_shared_at IS NULL\n            AND expires_at IS NULL\n        )\n        OR\n        (\n            first_shared_at IS NOT NULL\n            AND expires_at IS NOT NULL\n            AND expires_at = first_shared_at\n                + overall_ttl_seconds * INTERVAL '1 second'\n        )\n    "
        },
        "vaults_overall_ttl_check": {
          "name": "vaults_overall_ttl_check",
          "value": "\"vaults\".\"overall_ttl_seconds\" > 0"
        },
        "vaults_expiry_policy_check": {
          "name": "vaults_expiry_policy_check",
          "value": "\"vaults\".\"expiry_policy\" IN ('DESTROY', 'REVOKE_ACCESS')"
