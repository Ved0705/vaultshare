NODE_ENV=development
PORT=3000

# Comma-separated browser origins allowed to call the API.
# Production requires explicit HTTPS origins; never leave the development default.
CORS_ORIGINS=http://localhost:5173

# Exact trusted reverse-proxy hop count. Keep 0 unless topology is known.
TRUST_PROXY_HOPS=0

# AWS Cognito
COGNITO_USERINFO_URL=
COGNITO_REGION=
COGNITO_USER_POOL_ID=
COGNITO_CLIENT_ID=

# Database
DATABASE_URL=

# Local encrypted file storage
STORAGE_PATH=./private-storage

# Maximum size for one uploaded file (default 10 MiB; hard ceiling 100 MiB).
MAX_FILE_SIZE_BYTES=10485760

# Email (Mailpit for local development)
MAIL_HOST=localhost
MAIL_PORT=1025
MAIL_FROM=no-reply@vaultshare.local

# Keep KEK v1 until all v1 records and retained backups are safely rewrapped.
VAULT_KEK_BASE64=
VAULT_KEK_V2_BASE64=
VAULT_KEK_CURRENT_VERSION=1
