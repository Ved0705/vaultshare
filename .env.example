NODE_ENV=development
PORT=3000

# Comma-separated browser origins allowed to call the API
CORS_ORIGINS=http://localhost:5173

# AWS Cognito
COGNITO_USERINFO_URL=
COGNITO_REGION=
COGNITO_USER_POOL_ID=
COGNITO_CLIENT_ID=

# Database
DATABASE_URL=

# Local encrypted file storage
STORAGE_PATH=./private-storage

# Email (Mailpit for local development)
MAIL_HOST=localhost
MAIL_PORT=1025
MAIL_FROM=no-reply@vaultshare.local

# Encryption: version 1 is the existing key; retain it until all v1 records are rewrapped.
VAULT_KEK_BASE64=
# Add a new independent 32-byte key for rotation; never reuse the v1 key.
VAULT_KEK_V2_BASE64=
# Keep at 1 until the rotation dry-run and backup are complete; set to 2 for rotation.